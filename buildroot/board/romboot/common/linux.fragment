# The RomBoot appliance mounts a SquashFS root directly (root=/dev/mmcblk0p2,
# rootfstype=squashfs) with no initramfs, so SquashFS support must be built into
# the kernel (=y), not a loadable module. The Raspberry Pi vendor bcm2711_defconfig
# ships CONFIG_SQUASHFS=m (it targets an ext4 root), which panics our root mount.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y

# The VideoCore display/GPU must be built into the kernel (not a module) so
# /dev/dri/card0 exists at boot for RetroArch's kmsdrm driver. With no initramfs,
# a modular vc4 races the emulator launch and loses -> "[KMS]: Couldn't find a
# suitable DRM device." VC4 = VideoCore IV (Zero 2 W display+3D, Pi 4 display);
# V3D = VideoCore VI (Pi 4 3D).
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_VC4=y
CONFIG_DRM_V3D=y

# DRM_VC4 "depends on SND && SND_SOC", so these must also be built in (=y);
# otherwise kconfig silently caps CONFIG_DRM_VC4 at =m (SND ships as a module).
CONFIG_SND=y
CONFIG_SND_SOC=y

# The vc4 HDMI block reads EDID over the dedicated DDC I2C bus (i2c2). With the
# BCM2835 I2C driver as a module (no initramfs), the HDMI component defers
# forever waiting for its I2C bus, so the vc4 DRM card never completes and
# /dev/dri/card0 is never created. Build it in.
CONFIG_I2C_BCM2835=y

# The single micro-USB port is put into host mode via dtoverlay=dwc2,dr_mode=host
# for the USB gamepad. That overlay uses the upstream dwc2 controller driver,
# which must be built in (no initramfs) or the port has no host driver and the
# controller is never detected. JOYDEV is cheap insurance for input enumeration.
CONFIG_USB_DWC2=y
CONFIG_INPUT_JOYDEV=y
