# This is a safe template, replaced by the host image builder after ROM and
# BIOS validation.  Values are shell assignments; values must be quoted by the
# host builder and may not contain command substitutions or newlines.
ROMBOOT_EMULATOR="/usr/bin/retroarch"
ROMBOOT_CORE="/usr/lib/libretro/fceumm_libretro.so"
ROMBOOT_ROM="/rom/game.nes"
ROMBOOT_RETROARCH_CONFIG="/etc/retroarch.cfg"
ROMBOOT_EXIT_POLICY="shutdown"
ROMBOOT_LOG_BYTES="65536"
