{
  "schema_version": 1,
  "id": "pcengine",
  "name": "NEC PC Engine / TurboGrafx-16",
  "aliases": ["tg16", "turbografx16"],
  "extensions": [".pce"],
  "emulator": "retroarch",
  "core": "mednafen_pce_fast",
  "target_support": ["rpi4", "rpizero2w"],
  "bios": [],
  "status": "mvp-structural",
  "settings": {
    "emulator_path": "/usr/bin/retroarch",
    "core_path": "/usr/lib/libretro/mednafen_pce_fast_libretro.so",
    "retroarch_config": "/etc/retroarch.cfg",
    "aspect_ratio": "4:3",
    "integer_scaling": true,
    "region": "auto"
  },
  "notes": "BIOS-free HuCard only (CD-ROM2 would need a System Card BIOS). Physical Raspberry Pi verification is still required."
}
